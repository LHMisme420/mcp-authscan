# Local findings exports must not be included in published builds.
vata_findings_backup.json

# The web app installs requirements-runtime.txt explicitly with a writable prefix.
# CLI metadata lives under mcp_authscan/. These root-only rules are defense in
# depth for published files, not controls for pre-build package detection.
/pyproject.toml
/uv.lock

# Keep runtime Python packages and Gunicorn; omit only these unused launchers.
/.pythonlibs/bin/flask
/.pythonlibs/bin/cffi-gen-src

# Do not ship private workspace findings to the public application.
vata.db
vata.db-*

# Exclude all local recovery fixtures and private snapshots, not just vata.db.
*.db
*.db-*
**/*.db
**/*.db-*
*.sqlite
*.sqlite-*
**/*.sqlite
**/*.sqlite-*
*.sqlite3
*.sqlite3-*
**/*.sqlite3
**/*.sqlite3-*
runtime-data/
generated-artifacts/
**/.vata-restore-*/
**/.vata-recovery-*/
**/*.vata-dr
**/*.dump

# Standalone workspace scan exports are not application fixtures.
/*findings*.json
/*scan_results*.json
