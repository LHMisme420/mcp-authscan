{
  "name": "vata-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --packages=external --platform=node --format=esm --outfile=build/server/index.js && esbuild scripts/prepare-live-billing.ts --bundle --packages=external --platform=node --format=esm --outfile=build/server/prepare-live-billing.js",
    "start": "NODE_ENV=production node server/entry.mjs",
    "checkout:prepare": "tsx scripts/prepare-test-checkout.ts",
    "test:checkout": "tsx --test tests/test-checkout.test.ts tests/test-webhook.test.ts tests/preview-billing-webhook.test.ts",
    "checkout:verify": "tsx scripts/verify-test-checkout.ts",
    "checkout:rehearse": "tsx scripts/verify-test-subscriptions.ts",
    "checkout:connect-test-webhook": "tsx scripts/connect-test-webhook.ts",
    "checkout:verify-delivery": "tsx scripts/verify-test-subscriptions.ts --external",
    "test:startup": "npm run build && tsx --test tests/startup.test.ts",
    "test:findings-storage": "npm run build && tsx --test tests/findings-alerts.test.ts tests/findings-storage.test.ts",
    "test:independent-recovery": "npm run build && tsx --test tests/independent-recovery.test.ts tests/recovery-gcs.test.ts",
    "recovery:archive": "tsx scripts/recovery-archive.ts",
    "recovery:gcs": "tsx scripts/recovery-gcs.ts",
    "findings:seed": "tsx scripts/seed-findings-backup.ts",
    "billing:setup": "tsx scripts/seed-stripe.ts",
    "billing:prepare-live": "tsx scripts/prepare-live-billing.ts",
    "billing:verify-sandbox": "tsx scripts/verify-stripe.ts",
    "test:billing": "tsx --test tests/billing.test.ts tests/live-billing.test.ts tests/billing-panel.test.tsx"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@clerk/shared": "^4.40.0",
    "@clerk/themes": "^2.4.57",
    "@google-cloud/storage": "^7.22.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@tanstack/react-query": "^5.104.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.7",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0",
    "stripe-replit-sync": "^1.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wouter": "^3.13.0"
  }
}
